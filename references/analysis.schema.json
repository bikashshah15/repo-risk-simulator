{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "selection_notes": {
      "type": "string",
      "minLength": 1,
      "maxLength": 18000
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 18000
      },
      "minItems": 1
    },
    "context_notes": {
      "type": "array",
      "description": "Optional evidence-cited context that is not an advisory finding (e.g. unversioned dependencies, configuration observations).",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18000
            },
            "minItems": 1
          }
        },
        "required": [
          "text",
          "evidence_ids"
        ],
        "additionalProperties": false
      }
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "status": {
            "enum": [
              "unknown",
              "potentially_applicable",
              "ruled_out_under_evidence"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18000
            },
            "minItems": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18000
            },
            "minItems": 1
          }
        },
        "required": [
          "finding_id",
          "status",
          "rationale",
          "evidence_ids",
          "limitations"
        ],
        "additionalProperties": false
      }
    },
    "scenarios": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "finding_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18000
            },
            "minItems": 1
          },
          "facts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 18000
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 18000
                  },
                  "minItems": 1
                }
              },
              "required": [
                "text",
                "evidence_ids"
              ],
              "additionalProperties": false
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18000
            }
          },
          "unknowns": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18000
            }
          },
          "application_evidence_gap": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "prerequisites": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 18000
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 18000
                },
                "required_value": {
                  "type": "boolean"
                },
                "initial": {
                  "enum": [
                    "true",
                    "false",
                    "unknown"
                  ]
                },
                "basis": {
                  "enum": [
                    "observed",
                    "assumption"
                  ]
                },
                "explanation": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 18000
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 18000
                  }
                }
              },
              "required": [
                "id",
                "label",
                "required_value",
                "initial",
                "basis",
                "explanation",
                "evidence_ids"
              ],
              "additionalProperties": false
            }
          },
          "steps": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "type": "object",
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 18000
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 18000
                  }
                }
              },
              "required": [
                "text",
                "evidence_ids"
              ],
              "additionalProperties": false
            }
          },
          "hypothetical_impact": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 18000
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "finding_id",
          "title",
          "evidence_ids",
          "facts",
          "assumptions",
          "unknowns",
          "application_evidence_gap",
          "prerequisites",
          "steps",
          "hypothetical_impact",
          "limitations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "selection_notes",
    "limitations",
    "assessments",
    "scenarios"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:repo-risk-simulator:analysis:1",
  "title": "Repository Risk Simulator analysis"
}
